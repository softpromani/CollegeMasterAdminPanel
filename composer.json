{
    "name": "softpromani/college-admin",
    "description": "Universal Master Admin Panel Package for College Management Systems with Auto-Discovery & Version Updates",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "College Master Team",
            "email": "support@collegemaster.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0",
        "spatie/laravel-permission": "^6.0",
        "yajra/laravel-datatables-oracle": "^11.0|^12.0",
        "realrashid/sweet-alert": "^7.0"
    },
    "autoload": {
        "psr-4": {
            "CollegeAdmin\\": "src/",
            "CollegeAdmin\\Database\\Seeders\\": "database/seeders/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "CollegeAdmin\\CollegeAdminServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
